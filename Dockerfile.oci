FROM debian@sha256:4ffb3a1511099754cddc70eb1b12e50ffdb67619aa0ab6c13fcd800a78ef7c7a AS rust-builder
ENV DEBIAN_FRONTEND=noninteractive

# Pin Debian snapshots for 100% stable package versions
RUN echo 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/20260406T000000Z\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/20260406T000000Z\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp' > /etc/apt/sources.list.d/debian.sources

RUN apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y --no-install-recommends \
    curl ca-certificates gcc g++ make pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
ARG RUST_VERSION=1.91.1
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo \
    PATH=/usr/local/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain ${RUST_VERSION} --profile minimal --no-modify-path \
    && . /usr/local/cargo/env \
    && export RUST_MIN_STACK=16777216 \
    && cargo install -j 1 --root /usr --locked add-determinism \
    && rm -rf /usr/local/cargo/registry /usr/local/cargo/git

WORKDIR /app
COPY Cargo.toml Cargo.lock ./

ENV RUSTFLAGS="-C target-cpu=generic -C strip=symbols"

# Layer 1: compile dependencies
RUN bash -c ". /usr/local/cargo/env && \
    set -euo pipefail && \
    mkdir -p src && \
    echo 'fn main() {}' > src/main.rs && \
    cargo build --release --features oci --target x86_64-unknown-linux-gnu && \
    rm -f target/x86_64-unknown-linux-gnu/release/deps/paypal_auth_vm* \
          target/x86_64-unknown-linux-gnu/release/paypal_auth_vm* \
          target/x86_64-unknown-linux-gnu/release/deps/paypal-auth-vm*"

# Layer 2: compile our crate
COPY src ./src
RUN bash -c ". /usr/local/cargo/env && \
    set -euo pipefail && \
    cargo build --release --features oci --target x86_64-unknown-linux-gnu && \
    cp target/x86_64-unknown-linux-gnu/release/paypal-auth-vm /paypal-auth-vm-bin"

# Strip binary for determinism
RUN /usr/bin/add-det /paypal-auth-vm-bin && \
    rm -rf /usr/local/cargo/registry /usr/local/cargo/git


# -----------------------------------------------------------------------------
# Stage: extract Oracle Linux 10 (UEK8) boot binaries — the OS OCI lists as
# supported for confidential VM.Standard.E5.Flex (AMD SEV-SNP). Packages come
# pinned from Oracle's yum repos, identical content to the OCI platform image.
# -----------------------------------------------------------------------------
FROM oraclelinux:10@sha256:f685a1ff75f33c1b449bbc067b41a1f49878f467873874be2eabc383644e8a14 AS ol10-builder
COPY extract-ol10-binaries.sh /usr/local/bin/extract-ol10-binaries.sh
# /host-ol10 = binaries staged by extract-ol10-platform.sh directly from the
# OCI "Oracle Linux 10" platform image. When the build context only carries
# the placeholder (CI checkouts), fall back to the pinned-yum extraction.
COPY ol10 /host-ol10
RUN chmod +x /usr/local/bin/extract-ol10-binaries.sh \
    && if [ -f /host-ol10/vmlinuz ]; then \
           echo "Using OL10 platform-image binaries from build context" \
           && mkdir -p /ol10 && cp -a /host-ol10/. /ol10/ \
           && chmod -R a+rX /ol10 ; \
       else \
           echo "No staged ol10/ binaries — extracting pinned NEVRAs from Oracle yum" \
           && /usr/local/bin/extract-ol10-binaries.sh /ol10 ; \
       fi

FROM debian@sha256:4ffb3a1511099754cddc70eb1b12e50ffdb67619aa0ab6c13fcd800a78ef7c7a AS image-builder
ENV DEBIAN_FRONTEND=noninteractive
ENV SOURCE_DATE_EPOCH=1712260800
ENV TZ=UTC
ENV LC_ALL=C.UTF-8

# Pin Debian snapshots for 100% stable package versions (Trixie is current stable)
RUN echo 'Types: deb\nURIs: http://snapshot.debian.org/archive/debian/20260406T000000Z\nSuites: trixie trixie-updates\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp\n\nTypes: deb\nURIs: http://snapshot.debian.org/archive/debian-security/20260406T000000Z\nSuites: trixie-security\nComponents: main\nSigned-By: /usr/share/keyrings/debian-archive-keyring.pgp' > /etc/apt/sources.list.d/debian.sources

RUN apt-get -o Acquire::Check-Valid-Until=false update && apt-get install -y --no-install-recommends \
    curl ca-certificates gcc g++ make pkg-config libssl-dev \
    cpio xz-utils zstd qemu-utils mtools gdisk binutils initramfs-tools \
    linux-image-cloud-amd64 shim-signed grub-efi-amd64-signed \
    tpm2-tools iproute2 kmod python3 file dosfstools bash nftables \
    pciutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY --from=rust-builder /paypal-auth-vm-bin /build/paypal-auth-vm-bin
COPY --from=rust-builder /usr/bin/add-det /usr/bin/add-det
# Oracle Linux 10 (UEK8) kernel/shim/grub binaries from the ol10-builder stage
COPY --from=ol10-builder /ol10 /build/ol10

COPY build-initramfs-tools.sh build-oci-image.sh extract-ol10-binaries.sh ./
COPY src ./src

RUN chmod +x build-initramfs-tools.sh build-oci-image.sh && \
    dpkg-query -W -f='${Package} ${Version} ${Architecture}\n' | sort > /build/packages.txt && \
    echo "=== Installed Package Manifest ===" && cat /build/packages.txt && \
    BUILD_FEATURE=oci ./build-initramfs-tools.sh && \
    ./build-oci-image.sh && \
    rm -rf /usr/local/cargo/registry /usr/local/cargo/git

# Copy artifacts to root for easy extraction
RUN cp /build/paypal-auth-vm-oci.qcow2 /paypal-auth-vm-oci.qcow2 && \
    cp /build/output/initramfs-paypal-auth.img /initramfs-paypal-auth.img && \
    cp /build/output/grub.cfg /grub.cfg && \
    cp /build/packages.txt /packages.txt && \
    echo "Build Hashes:" && \
    sha256sum /paypal-auth-vm-oci.qcow2 /initramfs-paypal-auth.img /grub.cfg

CMD ["/bin/bash"]
